rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Hostella — правила доступа Firestore (именованная БД "hostella").
//
// ВАЖНО ОБ АРХИТЕКТУРЕ:
//   Сейчас приложение использует анонимный вход (signInAnonymously), а проверка
//   логина/пароля и ролей выполняется НА КЛИЕНТЕ. Поэтому на уровне правил можно
//   различить только «есть анонимная сессия / нет». Это НЕ защищает данные от
//   технически подкованного пользователя: любой, у кого есть публичный конфиг
//   Firebase (он в бандле), может пройти анонимную аутентификацию и получить
//   доступ к данным в обход UI.
//
//   Настоящая защита требует миграции на реальную аутентификацию (Firebase Auth
//   email/пароль или кастомные claims) и проверки ролей ЗДЕСЬ, в правилах.
//   До миграции эти правила лишь:
//     • закрывают базу от полностью анонимного (без sign-in) доступа и «test mode»;
//     • запрещают любой доступ вне рабочего пути artifacts/hostella-multi-v4.
//
//   Разверните: firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Рабочие данные приложения.
    //
    // ВАЖНО: правила складываются по ИЛИ — запретить что-то вложенным match нельзя,
    // поэтому исключения перечислены прямо в условии.
    //   userSecrets — хеши паролей (PBKDF2). Клиенту не нужны вовсе: вход проверяет
    //     Cloud Function authenticateUser. Без этого запрета любой анонимный клиент
    //     выгружал бы хеши и перебирал пароли офлайн.
    //   authThrottle — счётчики неудачных попыток входа. Будь они доступны на запись,
    //     защиту от перебора можно было бы просто обнулять.
    // Обе коллекции пишутся только Admin SDK из функций (правила его не ограничивают).
    match /artifacts/hostella-multi-v4/public/data/{col}/{rest=**} {
      allow read, write: if signedIn()
        && col != 'userSecrets'
        && col != 'authThrottle'
        && col != 'auditLog'
        && col != 'sessions';
    }

    // auditLog — только добавление (append-only). Приложение лишь создаёт записи
    // (logAction → addDoc); изменять/удалять их нельзя, чтобы нельзя было замести
    // следы: переписать или стереть собственные записи об операциях.
    match /artifacts/hostella-multi-v4/public/data/auditLog/{doc} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    // sessions — создание/обновление разрешено (старт, завершение, авто-закрытие),
    // но НЕ удаление: иначе можно было бы стереть историю входов задним числом.
    match /artifacts/hostella-multi-v4/public/data/sessions/{doc} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    // Сам документ data (без подколлекций) — как раньше.
    match /artifacts/hostella-multi-v4/public/data {
      allow read, write: if signedIn();
    }

    // Всё остальное — запрещено по умолчанию.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
