rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Hostella — ЗАМОК ПРАВИЛ (готовый черновик, НЕ активен).
//
// Это целевые правила, закрывающие корень C1: доступ по РОЛИ из кастом-токена,
// а не по факту анонимной сессии. Активируется вместо firestore.rules ТОЛЬКО когда
// выполнены пререквизиты (см. ниже), иначе заблокирует живые кассы.
//
// ПРЕРЕКВИЗИТЫ перед активацией:
//   1. Все кассы на сборке 0.15.0+ (вход мнёт кастом-токен с claims hostellaRole).  ✅ выпущено
//   2. Сервис-аккаунт умеет createCustomToken (роль Token Creator).                 ✅ проверено
//   3. useAppData вешает слушатели только после входа (на currentUser, не на аноним). ⏳ идёт с этим замком
//   4. Виджет брони пишет через createWebBooking, не в guests напрямую.             ✅ сделано
//   5. settings/appConfig остаётся читаем до входа (брендинг грузится анонимно).    ✅ учтено ниже
//
// Деплой (только по чек-листу, на спокойном окне, с готовым откатом):
//   cp firestore.rules.locked firestore.rules && firebase deploy --only firestore:rules
//   Откат: git checkout firestore.rules && firebase deploy --only firestore:rules
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.hostellaRole; }
    function isStaff()  { return signedIn() && role() in ['cashier', 'admin', 'super']; }
    function isAdmin()  { return signedIn() && role() in ['admin', 'super']; }
    function isSuper()  { return signedIn() && role() == 'super'; }

    match /artifacts/hostella-multi-v4/public/data {

      // Сам документ data (не подколлекции): читать может любая сессия, писать — админ.
      allow read:  if signedIn();
      allow write: if isAdmin();

      // ── settings ──────────────────────────────────────────────────────────
      // Читаемо любой сессии (брендинг/конфиг грузится ДО входа, аноним). Секретов
      // тут больше нет (токены → Secret Manager, superPassHash-fallback убран).
      // Запись — только админ: закрывает подмену получателей Telegram, глобальное
      // отключение аудита (auditEnabled), подмену минимальной цены.
      match /settings/{doc} {
        allow read:  if signedIn();
        allow write: if isAdmin();
      }

      // ── users ─────────────────────────────────────────────────────────────
      // Читают сотрудники (список персонала, авто-синк роли). Пишет только админ —
      // закрывает эскалацию (кассир ставил себе role:super) и форж супер-claims
      // через создание users-документа. (Пароли — в закрытой userSecrets.)
      match /users/{doc} {
        allow read:   if isStaff();
        allow write:  if isAdmin();
      }

      // ── PII гостей/клиентов ───────────────────────────────────────────────
      // Чтение — только сотрудники (закрывает анонимный экспорт паспортов, C6).
      // Публичная бронь создаётся функцией createWebBooking (Admin SDK, минует
      // правила), поэтому клиентский анонимный create больше НЕ нужен.
      match /guests/{doc}                { allow read, write: if isStaff(); }
      match /clients/{doc}               { allow read, write: if isStaff(); }
      match /registrations/{doc}         { allow read, write: if isStaff(); }
      match /cadastres/{doc}             { allow read, write: if isStaff(); }
      match /cadastreRegistrations/{doc} { allow read, write: if isStaff(); }
      match /clientVersions/{doc}        { allow read, write: if isStaff(); }

      // ── Финансы / операции ────────────────────────────────────────────────
      // Закрывает подделку/стирание платежей, смен, долгов через SDK (C7).
      match /payments/{doc}          { allow read, write: if isStaff(); }
      match /expenses/{doc}          { allow read, write: if isStaff(); }
      match /recurringExpenses/{doc} { allow read, write: if isStaff(); }
      match /shifts/{doc}            { allow read, write: if isStaff(); }
      match /manualStayGroups/{doc}  { allow read, write: if isStaff(); }
      match /rooms/{doc}             { allow read, write: if isStaff(); }
      match /tasks/{doc}             { allow read, write: if isStaff(); }
      match /bookingCom/{doc}        { allow read, write: if isStaff(); }
      match /userPrefs/{doc}         { allow read, write: if isStaff(); }

      // ── Промокоды ─────────────────────────────────────────────────────────
      // Читают сотрудники (виджет берёт активные промо через функцию). Пишет
      // только админ — закрывает форж/сброс счётчиков/100%-скидки анонимом.
      match /promos/{doc} {
        allow read:  if isStaff();
        allow write: if isAdmin();
      }

      // ── Разрешения на понижение цены ──────────────────────────────────────
      // priceWhitelist пишет только админ (закрывает самоодобрение скидки, P1).
      // priceRequests: сотрудник создаёт запрос и читает статус, но ОДОБРЯЕТ
      // (update status) только webhook через Admin SDK — закрывает самоодобрение P2.
      match /priceWhitelist/{doc} {
        allow read:  if isStaff();
        allow write: if isAdmin();
      }
      match /priceRequests/{doc} {
        allow read, create: if isStaff();
        allow update, delete: if false;   // одобрение — только серверная функция
      }

      // ── sessions ──────────────────────────────────────────────────────────
      // Читает админ (журнал сессий). Создание/обновление — сотрудник (вход пишет
      // свою сессию). Удаление запрещено (нельзя стереть историю входов).
      match /sessions/{doc} {
        allow read:            if isAdmin();
        allow create, update:  if isStaff();
        allow delete:          if false;
      }

      // ── auditLog ──────────────────────────────────────────────────────────
      // Append-only: сотрудник только СОЗДаёт запись, изменить/удалить нельзя.
      // Читает супер. (Полная защита — запись аудита из функций; это следующий шаг.)
      match /auditLog/{doc} {
        allow read:   if isSuper();
        allow create: if isStaff();
        allow update, delete: if false;
      }

      // Закрытые коллекции — только Admin SDK (функции).
      match /userSecrets/{doc}  { allow read, write: if false; }
      match /authThrottle/{doc} { allow read, write: if false; }
    }

    // Всё остальное — запрещено.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
