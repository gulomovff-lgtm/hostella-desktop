{
  "name": "hostella-desktop",
  "private": true,
  "version": "0.15.70",
  "description": "Hostella Management System",
  "author": "Fazliddin Gulomov",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "node scripts/kill-dev.js && concurrently -k \"cross-env BROWSER=none npm run react-start\" \"npm run electron-start\"",
    "react-start": "vite",
    "electron-start": "wait-on http://localhost:5173 && electron .",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "build": "vite build",
    "build:electron": "vite build --config vite.electron.config.js",
    "clean": "npx rimraf release",
    "dist": "npm run clean && npm run build:electron && electron-builder build --publish always",
    "deploy": "npm run build && firebase deploy --only hosting",
    "lint": "eslint src electron functions tests",
    "lint:fix": "eslint src electron functions tests --fix"
  },
  "build": {
    "appId": "com.hostella.app",
    "productName": "Hostella",
    "copyright": "Copyright Р В Р’В Р Р†Р вЂљРІвЂћСћР В РІР‚в„ўР вЂ™Р’В© 2026",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gulomovff-lgtm",
        "repo": "hostella-desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/ic.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hostella",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "assets/hostella-splash.ps1",
        "to": "hostella-splash.ps1"
      },
      {
        "from": "assets/splash-logo.png",
        "to": "splash-logo.png"
      }
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.54.0",
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.7",
    "exceljs": "^4.4.0",
    "firebase": "13.1.0",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.300.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^44.10.2",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^5.0.0",
    "wait-on": "^7.0.0"
  },
  "overrides": {
    "@firebase/ai": "3.0.0",
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.8",
    "@firebase/util": "1.15.3",
    "@firebase/storage": "0.14.6",
    "@firebase/database": "1.1.5",
    "@firebase/analytics": "0.10.25",
    "@firebase/app-check": "0.13.1",
    "@firebase/app-types": "0.9.6",
    "@firebase/firestore": "4.19.0",
    "@firebase/functions": "0.14.0",
    "@firebase/messaging": "0.13.3",
    "@firebase/app-compat": "0.5.20",
    "@firebase/auth-compat": "0.6.13",
    "@firebase/performance": "0.7.14",
    "@firebase/data-connect": "0.7.4",
    "@firebase/installations": "0.6.24",
    "@firebase/remote-config": "0.9.3",
    "@firebase/storage-compat": "0.4.6",
    "@firebase/database-compat": "2.1.7",
    "@firebase/analytics-compat": "0.2.31",
    "@firebase/app-check-compat": "0.4.7",
    "@firebase/firestore-compat": "0.4.16",
    "@firebase/functions-compat": "0.5.0",
    "@firebase/messaging-compat": "0.2.30",
    "@firebase/performance-compat": "0.2.27",
    "@firebase/installations-compat": "0.2.24",
    "@firebase/remote-config-compat": "0.2.30"
  }
}
